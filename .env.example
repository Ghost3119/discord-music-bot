# Bot existente: conserva los valores privados en .env, nunca en Git.
DISCORD_TOKEN=
CLIENT_ID=
GUILD_ID=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
AUDIO_PRELOADER_ENABLED=true

# Panel opcional. No se inicia con false y no requiere OAuth hasta habilitarlo.
WEB_ENABLED=false
WEB_HOST=127.0.0.1
WEB_PORT=8080
# Puerto de la vista con npm run dev; origen y callback se ajustan en memoria.
WEB_DEV_PORT=5173
WEB_ORIGIN=http://127.0.0.1:8080
# Se usa CLIENT_ID si WEB_CLIENT_ID está vacío/no definido.
# WEB_CLIENT_ID=123456789012345678
WEB_CLIENT_SECRET=
WEB_REDIRECT_URI=http://127.0.0.1:8080/auth/discord/callback
WEB_ALLOWED_USER_IDS=
WEB_DATABASE_PATH=data/dashboard.sqlite
WEB_SESSION_TTL_HOURS=168

# npm run dev ajusta ORIGIN y REDIRECT_URI en memoria para el puerto WEB_DEV_PORT.
# Registra http://127.0.0.1:5173/auth/discord/callback en Discord para ese modo.
