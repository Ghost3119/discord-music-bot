{
  "name": "discord-music-bot",
  "version": "1.0.0",
  "description": "Private Discord music bot with DisTube",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "test": "tsc && node --test \"test/*.test.js\"",
    "start": "node scripts/supervise.cjs",
    "start:once": "node --no-deprecation dist/bootstrap.js",
    "update:ytdlp": "node scripts/update-ytdlp.cjs",
    "dev": "ts-node src/bootstrap.ts",
    "deploy": "ts-node src/deploy-commands.ts"
  },
  "dependencies": {
    "@discordjs/opus": "^0.10.0",
    "@distube/spotify": "^2.0.2",
    "@distube/yt-dlp": "^2.0.1",
    "discord.js": "^14.16.3",
    "distube": "^5.0.3",
    "dotenv": "^16.4.5",
    "ffmpeg-static": "^5.3.0",
    "libsodium-wrappers": "^0.8.4"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  }
}
