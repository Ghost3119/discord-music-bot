{
  "name": "discord-music-bot",
  "version": "1.0.0",
  "description": "Private Discord music bot with DisTube",
  "main": "dist/index.js",
  "scripts": {
    "build": "npm run build:bot && npm run build:web",
    "build:bot": "tsc",
    "build:web": "npm --prefix frontend run build",
    "test": "npm run test:bot && npm run test:web",
    "test:bot": "tsc && node --test \"test/*.test.js\"",
    "test:web": "npm --prefix frontend test",
    "dev:web": "npm --prefix frontend run dev",
    "setup:web": "npm --prefix frontend ci",
    "start": "node scripts/supervise.cjs",
    "start:once": "node --no-deprecation dist/bootstrap.js",
    "update:ytdlp": "node scripts/update-ytdlp.cjs",
    "dev": "ts-node src/bootstrap.ts",
    "deploy": "ts-node src/deploy-commands.ts",
    "deploy:check": "ts-node src/deploy-commands.ts --dry-run"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@discordjs/opus": "^0.10.0",
    "@discordjs/voice": "0.19.2",
    "@distube/spotify": "^2.0.2",
    "@distube/yt-dlp": "^2.0.1",
    "@fastify/cookie": "^11.1.3",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.6",
    "better-sqlite3": "^12.11.1",
    "discord.js": "^14.16.3",
    "distube": "^5.0.3",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "ffmpeg-static": "^5.3.0",
    "libsodium-wrappers": "^0.8.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.9.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  },
  "overrides": {
    "tar": "^7.5.22"
  }
}
